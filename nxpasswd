#!/usr/bin/env bash
# Store (or replace) the ENICS password in the macOS Keychain, where the other nx* tools read it.
# security prompts for the password (twice) without echoing it.
#   nxpasswd
set -e
USER_NAME=yeminie
security add-generic-password -U -l 'ENICS VPN' -s fortivpn -a "$USER_NAME" -w
security find-generic-password -s fortivpn -a "$USER_NAME" >/dev/null && echo "Password stored for $USER_NAME."
